# ---- Application ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL_DAYS=7

# ---- Rate limiting ----
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
THROTTLE_AUTH_LIMIT=20

# ---- Admin bootstrap (used by prisma/seed.ts) ----
ADMIN_EMAIL=admin@marketplace.dev
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Admin

# ---- Payments (optional) ----
# Unset -> PaymentsModule falls back to FakePaymentProvider. Use a Stripe
# test-mode secret key (sk_test_...), never a live key, in any environment
# this app runs in outside real production.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` in
# dev, or the endpoint's "Signing secret" in the Stripe dashboard otherwise.
# Unset -> the webhook endpoint rejects every request (no signature can ever
# verify without it), which is the safe default rather than accepting
# unverified webhook payloads.
STRIPE_WEBHOOK_SECRET=

# ---- Grafana alert email (prod only, docker-compose.prod.yml) ----
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_FROM_ADDRESS=alerts@example.com
